RENDER_API_KEY=
RENDER_WORKSPACE_ID=

# Private Amazon S3 bucket. Use temporary AWS credentials when possible.
S3_BUCKET=
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required when you use temporary AWS credentials.
AWS_SESSION_TOKEN=

# Private Cloudflare R2 bucket. Use its S3 API credentials.
R2_BUCKET=
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Set this value only when you use temporary R2 credentials.
R2_SESSION_TOKEN=
